# ─────────────────────────────────────────────────────────────
# LifeOS environment
# Copy to .env and fill in. Never commit .env.
# ─────────────────────────────────────────────────────────────

# ── Firebase Web config (SAFE to expose — these are public) ──
# Firebase console → Project settings → General → "Your apps" → Web app → Config
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# ── Firebase Admin (SECRET — server only, used to verify ID tokens
#    and read Firestore for the AI features) ──
# Firebase console → Project settings → Service accounts → "Generate new private key"
# Paste the ENTIRE downloaded JSON on one line (or base64-encode it).
FIREBASE_SERVICE_ACCOUNT=""
# Optional alternative: base64 of the JSON (use this if the raw JSON breaks your env parser)
FIREBASE_SERVICE_ACCOUNT_B64=""

# ── AI (Google Gemini — for Brain Dump, prioritization, assistant) ──
GEMINI_API_KEY=""
# "gemini-flash-latest" auto-tracks the newest Flash. Pin a version (e.g.
# "gemini-3.6-flash") if you want it stable. Older models like gemini-2.5-flash
# are unavailable to new API keys; gemini-3.5-flash free tier is only 20 req/day.
GEMINI_MODEL="gemini-flash-latest"
# Optional: use Claude instead if you have a key. auto = Anthropic > Gemini > offline
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"
AI_PROVIDER="auto"

# ── App ──
NEXT_PUBLIC_APP_NAME="LifeOS"
# Public origin of this deployment — used to build the Canvas OAuth redirect URI.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ── Canvas LMS integration (optional — school data source) ──────────
# Canvas OAuth is per-institution: each school issues its own developer key.
# Register LifeOS as a Developer Key on the target Canvas instance, then set:
#   Redirect URI (in Canvas)  =  <NEXT_PUBLIC_APP_URL>/api/canvas/callback
CANVAS_CLIENT_ID=""
CANVAS_CLIENT_SECRET=""
CANVAS_REDIRECT_URI="http://localhost:3000/api/canvas/callback"
# Optional: pre-fills the "connect" field (e.g. "https://canvas.instructure.com").
CANVAS_DEFAULT_INSTANCE_URL=""
# CSV allowlist of permitted Canvas hostnames. Empty = allow any Canvas domain.
# A Canvas Developer Key only works for the institution that issued it, so for a
# single-district deployment set this to just your district's Canvas host, e.g.
#   CANVAS_ALLOWED_INSTANCE_HOSTS="yourdistrict.instructure.com"
# With exactly one host, the UI hides the URL field and shows a single Connect button.
CANVAS_ALLOWED_INSTANCE_HOSTS=""
# Secrets for encrypting stored tokens + signing the OAuth state. Generate with:
#   openssl rand -base64 48
CANVAS_TOKEN_SECRET=""
CANVAS_STATE_SECRET=""
# Set to "1" to run against canned fixtures (no real Canvas key needed) for local testing.
CANVAS_MOCK=""
# DEV ONLY — lets a user paste a Canvas personal access token instead of doing OAuth
# (Account -> Settings -> New Access Token). Canvas' API Policy forbids pasted tokens
# for multi-user apps, so scope it tight. Leave empty for OAuth only.
#   CANVAS_ALLOW_PERSONAL_TOKEN="1"                  -> any signed-in user (local only)
#   CANVAS_ALLOW_PERSONAL_TOKEN="you@school.edu"     -> only that LifeOS account email
CANVAS_ALLOW_PERSONAL_TOKEN=""
